{
  "owner": "NerdbucketInc",
  "cloneUrl": "ssh://git@ssh.github.com:443/{owner}/{repo}.git",
  "statusContext": "cluster/build",
  "releaseStatusContext": "cluster/release",
  "rehearsalStatusContext": "cluster/rehearsal",
  "tagMode": "release",
  "testTagPrefix": "cluster-",
  "buildNumberFloor": 1000,
  "maxMainBacklog": 20,
  "pollSeconds": 300,
  "activeDeadlineSeconds": 3600,
  "jobTtlSeconds": 86400,
  "logRetentionDays": 30,
  "logMaxBytes": 2147483648,
  "repos": {
    "stockpile": {
      "buildArgs": { "BUILD_SHA": "sha7", "BUILD_NUMBER": "number", "BUILD_DATE": "date", "BUILD_REF": "ref" },
      "images": [
        { "name": "api", "dockerfile": "apps/api/Dockerfile", "repository": "ghcr.io/nerdbucketinc/stockpile-api" },
        { "name": "web", "dockerfile": "apps/web/Dockerfile", "repository": "ghcr.io/nerdbucketinc/stockpile-web" }
      ],
      "rehearsal": {
        "template": "rehearsal-stockpile",
        "image": "api",
        "registryTags": "^main-([0-9a-f]{7,40})-b([0-9]+)$",
        "registryLookback": 10,
        "maxRegistryBacklog": 5,
        "previous": {
          "namespace": "batcave",
          "deployment": "stockpile-api",
          "container": "main"
        },
        "activeDeadlineSeconds": 1800,
        "ttlSecondsAfterFinished": 3600
      }
    },
    "sutler": {
      "buildArgs": { "VERSION": "version" },
      "images": [
        { "name": "api", "dockerfile": "apps/api/Dockerfile", "repository": "ghcr.io/nerdbucketinc/sutler-api" },
        { "name": "web", "dockerfile": "apps/web/Dockerfile", "repository": "ghcr.io/nerdbucketinc/sutler-web" }
      ]
    }
  }
}
