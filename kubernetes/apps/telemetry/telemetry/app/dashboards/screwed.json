      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH gone AS (SELECT install FROM events WHERE game = 'screwed' GROUP BY install HAVING max(event_time) < now() - interval '7 days' AND $__timeFilter(max(event_time))), reached AS (SELECT install, max((CASE WHEN jsonb_typeof(body->'level') = 'number' THEN (body->>'level')::numeric END)::int) AS level FROM events WHERE game = 'screwed' AND event = 'level_start' AND (CASE WHEN jsonb_typeof(body->'level') = 'number' THEN (body->>'level')::numeric END)::int >= 1 GROUP BY install), last AS (SELECT DISTINCT ON (install) install, event FROM events WHERE game = 'screwed' AND install IN (SELECT install FROM events WHERE game = 'screwed' GROUP BY install HAVING max(event_time) < now() - interval '7 days' AND $__timeFilter(max(event_time))) ORDER BY install, event_time DESC, n DESC) SELECT r.level, count(*) AS installs, round(100.0 * count(*) / sum(count(*)) OVER (), 1) AS \"share %\", mode() WITHIN GROUP (ORDER BY l.event) AS \"usual last event\" FROM gone JOIN reached r USING (install) JOIN last l USING (install) GROUP BY r.level ORDER BY installs DESC LIMIT 20"
        }
      ]
    },
