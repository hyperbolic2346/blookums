          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS \"new installs\" FROM (SELECT install, min(event_time) AS first_seen FROM events WHERE game = 'screwed' AND event = 'session_start' GROUP BY install) f WHERE $__timeFilter(first_seen)"
