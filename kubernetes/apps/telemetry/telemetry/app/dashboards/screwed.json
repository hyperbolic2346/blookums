          "format": "table",
          "rawSql": "SELECT (CASE WHEN jsonb_typeof(body->'level') = 'number' THEN (body->>'level')::numeric END)::int::text AS level, round(count(*)::numeric / count(DISTINCT install), 2) AS \"starts per install\" FROM events WHERE game = 'screwed' AND event = 'level_start' AND (CASE WHEN jsonb_typeof(body->'level') = 'number' THEN (body->>'level')::numeric END)::int >= 1 AND $__timeFilter(event_time) GROUP BY (CASE WHEN jsonb_typeof(body->'level') = 'number' THEN (body->>'level')::numeric END)::int ORDER BY (CASE WHEN jsonb_typeof(body->'level') = 'number' THEN (body->>'level')::numeric END)::int LIMIT 300"
