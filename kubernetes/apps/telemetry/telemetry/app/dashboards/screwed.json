    {
      "type": "barchart",
      "title": "Sticking points: where installs not seen for 7 days stopped",
      "description": "Each install's highest level started, for installs whose last event is over 7 days old and falls in the time range.",
      "options": {
        "xField": "level",
        "stacking": "none",
        "showValue": "never",
        "xTickLabelSpacing": 50,
        "legend": {
          "displayMode": "list",
