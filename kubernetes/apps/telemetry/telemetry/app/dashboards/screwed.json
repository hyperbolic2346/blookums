          "rawSql": "SELECT (CASE WHEN jsonb_typeof(body->'level') = 'number' THEN (body->>'level')::numeric END)::int::text AS level, count(*) FILTER (WHERE body->>'result' = 'win') AS \"win\", count(*) FILTER (WHERE body->>'result' = 'loss') AS \"loss\", count(*) FILTER (WHERE body->>'result' = 'quit') AS \"quit\" FROM (SELECT * FROM events WHERE game = 'screwed' AND event = 'level_end' AND $__timeFilter(event_time)) v WHERE (CASE WHEN jsonb_typeof(body->'level') = 'number' THEN (body->>'level')::numeric END)::int >= 1 GROUP BY (CASE WHEN jsonb_typeof(body->'level') = 'number' THEN (body->>'level')::numeric END)::int ORDER BY (CASE WHEN jsonb_typeof(body->'level') = 'number' THEN (body->>'level')::numeric END)::int LIMIT 300"
