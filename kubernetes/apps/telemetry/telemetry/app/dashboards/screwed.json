      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "telemetry-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH gone AS (SELECT install FROM events WHERE game = 'screwed' GROUP BY install HAVING max(event_time) < now() - interval '7 days' AND $__timeFilter(max(event_time))), reached AS (SELECT install, max((CASE WHEN jsonb_typeof(body->'level') = 'number' THEN (body->>'level')::numeric END)::int) AS level FROM events WHERE game = 'screwed' AND event = 'level_start' AND (CASE WHEN jsonb_typeof(body->'level') = 'number' THEN (body->>'level')::numeric END)::int >= 1 GROUP BY install) SELECT r.level::text AS level, count(*) AS installs FROM gone JOIN reached r USING (install) GROUP BY r.level ORDER BY r.level LIMIT 300"
        }
      ]
    },
    {
      "type": "table",
      "title": "Sticking points, worst first",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
