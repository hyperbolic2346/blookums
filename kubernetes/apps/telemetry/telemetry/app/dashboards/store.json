          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT country, sum(units) AS downloads FROM store_daily WHERE store = 'apple' AND app IN ($app) AND $__timeFilter(day::timestamptz) AND kind = 'download' GROUP BY country HAVING sum(units) > 0"
