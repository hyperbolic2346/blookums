          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT country, coalesce(sum(units) FILTER (WHERE kind = 'download'), 0) AS downloads, coalesce(sum(units) FILTER (WHERE kind = 'redownload'), 0) AS redownloads, coalesce(sum(units) FILTER (WHERE kind = 'iap'), 0) AS purchases, coalesce(sum(units) FILTER (WHERE kind = 'update'), 0) AS updates FROM store_daily WHERE store = 'apple' AND app IN ($app) AND $__timeFilter(day::timestamptz) GROUP BY country ORDER BY downloads DESC, purchases DESC"
        }
