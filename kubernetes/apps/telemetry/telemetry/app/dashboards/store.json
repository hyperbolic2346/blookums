        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "telemetry-postgres"
        },
        "query": "SELECT DISTINCT app FROM store_daily ORDER BY 1",
        "definition": "SELECT DISTINCT app FROM store_daily ORDER BY 1",
        "multi": true,
