      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(sum(units) FILTER (WHERE kind = 'download'), 0) AS downloads FROM store_daily WHERE store = 'apple' AND app IN ($app) AND $__timeFilter(day::timestamptz)"
        }
      ]
    },
