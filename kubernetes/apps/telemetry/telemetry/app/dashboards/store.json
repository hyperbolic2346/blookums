{
  "title": "Store downloads",
  "uid": "telemetry-store",
  "description": "App Store Connect's daily Sales reports for every Nerdbucket app: downloads, redownloads and purchases by country. Aggregate store data, kept for good.",
  "tags": [
    "telemetry",
    "store"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
